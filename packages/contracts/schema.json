    "ReviewState": {
      "enum": [
        "unreviewed",
        "needs-investigation",
        "confirmed",
        "dismissed"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "SelectionDecision": {
      "additionalProperties": false,
      "description": "Deterministic per-file selection decision.\n\nrule_id/language/bytes are REQUIRED (non-null) whenever status is\nexcluded/limited/failed so every coverage gap is attributable.\npath is informational and may carry the offending path of a rejected\nentry (e.g. traversal attempts); only DiffFileEntry enforces the strict\nrepo-relative shape.",
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "snapshot_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/SelectionStatus"
        }
      },
      "required": [
        "snapshot_id",
        "path",
        "status",
        "reason"
      ],
      "title": "SelectionDecision",
      "type": "object"
    },
    "SelectionStatus": {
      "enum": [
        "selected",
        "excluded",
        "limited",
        "failed"
      ],
      "title": "SelectionStatus",
      "type": "string"
    },
    "SnapshotIdentity": {
      "additionalProperties": false,
      "description": "Immutable identity of the analyzed input.\n\nsnapshot_id = sha256(\"morphojudge-snapshot-v1\\0\" + repository_id + \"\\0\"\n                     + base_commit + \"\\0\" + target_commit + \"\\0\"\n                     + rules_version)  \u2014 see docs/contract-freezes.md F1.5.",
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "canonical_path": {
          "minLength": 1,
          "title": "Canonical Path",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repository Id",
          "type": "string"
        },
        "rules_version": {
          "minLength": 1,
          "title": "Rules Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "target_commit": {
          "title": "Target Commit",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "canonical_path",
        "base_commit",
        "target_commit",
        "snapshot_id",
        "rules_version"
      ],
      "title": "SnapshotIdentity",
      "type": "object"
    },
    "SnapshotReport": {
      "additionalProperties": false,
      "description": "Snapshot resolution result: identity plus boundary observations.\n\nworkspace_dirty does not change snapshot_id (identity binds commits).\nnotes carry explicit limitation flags such as submodule_present,\nlfs_filter_present, base_equals_target.",
      "properties": {
        "identity": {
          "$ref": "#/definitions/SnapshotIdentity"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "working_tree": {
          "items": {
            "$ref": "#/definitions/WorkingTreeEntry"
          },
          "title": "Working Tree",
          "type": "array"
        },
        "workspace_dirty": {
          "title": "Workspace Dirty",
          "type": "boolean"
        }
      },
      "required": [
        "identity",
        "workspace_dirty"
      ],
      "title": "SnapshotReport",
      "type": "object"
    },
    "SoftwareMap": {
      "additionalProperties": false,
      "description": "Deterministic software map for one snapshot (REL-001).\n\nnodes/edges are the graph; truncated means a build/query budget was hit\n(limits lists the named budgets). Bad edges stay in the list while the\nadjacency layer records them as errors. file_reports makes every edge's\nprovenance traceable to the parse status of its source file.",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/definitions/MapEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "file_reports": {
          "items": {
            "$ref": "#/definitions/FileParseReport"
          },
          "title": "File Reports",
          "type": "array"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "title": "Limits",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/definitions/MapNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "snapshot_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "snapshot_id"
      ],
      "title": "SoftwareMap",
      "type": "object"
    },
    "StageName": {
      "enum": [
        "git",
        "selection",
        "parse",
        "behavior",
        "dependency",
        "report",
        "explain"
      ],
      "title": "StageName",
      "type": "string"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "stage": {
          "$ref": "#/definitions/StageName"
        },
        "status": {
